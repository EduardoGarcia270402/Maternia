xGraphModel></diagram><diagram id="epag" name="Estados: evento de seguimiento"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="980" pageHeight="660" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e1" value="" style="rounded=1;absoluteArcSize=1;arcSize=44;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#8a96a3;strokeWidth=1.4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="150.0" y="60.0" width="300.0" height="400.0" as="geometry"/></mxCell><mxCell id="e2" value="Vigente" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="166.0" y="70.2" width="68.8" height="21.0" as="geometry"/></mxCell><mxCell id="e3" value="" style="ellipse;html=1;fillColor=#1d2733;strokeColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="14.0" y="154.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b style=&quot;font-size:17px&quot;&gt;Pendiente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;fecha clínica y fecha&lt;br&gt;de aviso calculadas&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#dcefff;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="200.0" y="110.0" width="200.0" height="110.0" as="geometry"/></mxCell><mxCell id="e5" value="calcular con la" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="39.6" y="127.4" width="110.8" height="16.8" as="geometry"/></mxCell><mxCell id="e6" value="regla aprobada" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="43.0" y="142.4" width="104.1" height="16.8" as="geometry"/></mxCell><mxCell id="e7" value="&lt;b style=&quot;font-size:17px&quot;&gt;Confirmado&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;la obstetra revisó la&lt;br&gt;fecha; ya se puede&lt;br&gt;recordar a la paciente&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#cfe8f7;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="200.0" y="310.0" width="200.0" height="120.0" as="geometry"/></mxCell><mxCell id="e8" value="la obstetra" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="312.0" y="247.4" width="83.9" height="16.8" as="geometry"/></mxCell><mxCell id="e9" value="confirma" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="312.0" y="262.4" width="63.8" height="16.8" as="geometry"/></mxCell><mxCell id="e10" value="&lt;b style=&quot;font-size:17px&quot;&gt;Cumplido&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;el control se hizo&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#e3f4e3;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="640.0" y="60.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="e11" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="912.0" y="92.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="e12" value="&lt;b style=&quot;font-size:17px&quot;&gt;Anulado&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;con su motivo&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#f1e4c8;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="640.0" y="230.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="e13" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="912.0" y="262.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="e14" value="&lt;b style=&quot;font-size:17px&quot;&gt;Reemplazado&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;lo sustituye un evento nuevo&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#ebdcf5;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="640.0" y="400.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="e15" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="912.0" y="432.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="e16" value="se registra en una" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="479.5" y="67.4" width="131.0" height="16.8" as="geometry"/></mxCell><mxCell id="e17" value="consulta que se hizo" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="472.8" y="82.4" width="144.4" height="16.8" as="geometry"/></mxCell><mxCell id="e18" value="se anula con motivo o" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="469.4" y="237.4" width="151.1" height="16.8" as="geometry"/></mxCell><mxCell id="e19" value="se cierra el episodio" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="469.4" y="252.4" width="151.1" height="16.8" as="geometry"/></mxCell><mxCell id="e20" value="cambia un dato de" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="482.9" y="407.4" width="124.2" height="16.8" as="geometry"/></mxCell><mxCell id="e21" value="entrada; se recalcula" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="469.4" y="422.4" width="151.1" height="16.8" as="geometry"/></mxCell><mxCell id="e22" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9b458;strokeWidth=1.4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20.0" y="490.0" width="440.0" height="128.0" as="geometry"/></mxCell><mxCell id="e23" value="«Vencido» no es un estado guardado: se deduce" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="500.9" width="325.0" height="17.5" as="geometry"/></mxCell><mxCell id="e24" value="cuando la fecha clínica pasó y el evento sigue" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="518.9" width="332.0" height="17.5" as="geometry"/></mxCell><mxCell id="e25" value="vigente. Si la paciente llega tarde, el evento" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="536.9" width="332.0" height="17.5" as="geometry"/></mxCell><mxCell id="e26" value="nace vencido y la obstetra decide." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="554.9" width="248.0" height="17.5" as="geometry"/></mxCell><mxCell id="e27" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9b458;strokeWidth=1.4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="480.0" y="490.0" width="460.0" height="128.0" as="geometry"/></mxCell><mxCell id="e28" value="Solo un evento confirmado y sin cita se recuerda" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="494.0" y="500.9" width="346.0" height="17.5" as="geometry"/></mxCell><mxCell id="e29" value="a la paciente; si tiene cita, se recuerda la cita." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="494.0" y="518.9" width="360.0" height="17.5" as="geometry"/></mxCell><mxCell id="e30" value="Un evento cumplido no se recalcula aunque" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="494.0" y="536.9" width="297.0" height="17.5" as="geometry"/></mxCell><mxCell id="e31" value="después se corrija la fecha de entrada." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" ver