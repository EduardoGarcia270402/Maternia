<mxGeometry x="43.0" y="233.4" width="83.9" height="16.8" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b style=&quot;font-size:17px&quot;&gt;Atendida&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;queda enlazada a la consulta&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#e3f4e3;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="600.0" y="20.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="a6" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="872.0" y="52.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b style=&quot;font-size:17px&quot;&gt;No asistió&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;el evento vuelve a la bandeja&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#f5dcdc;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="600.0" y="150.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="a8" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="872.0" y="182.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b style=&quot;font-size:17px&quot;&gt;Reprogramada&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;una cita nueva apunta a esta&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#ebdcf5;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="600.0" y="280.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="a10" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="872.0" y="312.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b style=&quot;font-size:17px&quot;&gt;Anulada&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5a6672&quot;&gt;se registró por error&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=36;html=1;whiteSpace=wrap;fillColor=#f1e4c8;strokeColor=#4b5864;strokeWidth=1.8;fontSize=12.5;fontFamily=Helvetica;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="600.0" y="410.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="a12" value="" style="ellipse;html=1;shape=endState;fillColor=#1d2733;strokeColor=#1d2733;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="872.0" y="442.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="a13" value="la paciente llega" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="432.0" y="97.4" width="124.2" height="16.8" as="geometry"/></mxCell><mxCell id="a14" value="y se atiende" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="432.0" y="112.4" width="90.6" height="16.8" as="geometry"/></mxCell><mxCell id="a15" value="pasó la hora y" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="482.0" y="215.4" width="104.1" height="16.8" as="geometry"/></mxCell><mxCell id="a16" value="no llegó" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="482.0" y="230.4" width="63.8" height="16.8" as="geometry"/></mxCell><mxCell id="a17" value="pide otra" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="482.0" y="265.4" width="70.5" height="16.8" as="geometry"/></mxCell><mxCell id="a18" value="fecha" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="482.0" y="280.4" width="43.6" height="16.8" as="geometry"/></mxCell><mxCell id="a19" value="la obstetra la anula" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="347.8" y="417.4" width="144.4" height="16.8" as="geometry"/></mxCell><mxCell id="a20" value="con su motivo" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#5a6672;" vertex="1" parent="1"><mxGeometry x="371.3" y="432.4" width="97.4" height="16.8" as="geometry"/></mxCell><mxCell id="a21" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9b458;strokeWidth=1.4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20.0" y="520.0" width="880.0" height="92.0" as="geometry"/></mxCell><mxCell id="a22" value="Al salir de Confirmada se cancela su recordatorio pendiente. La cita nueva de una reprogramación nace Confirmada" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="532.9" width="794.0" height="17.5" as="geometry"/></mxCell><mxCell id="a23" value="y guarda la anterior. Un evento tiene a lo sumo una cita confirmada, y si la paciente no asistió el evento sigue" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="550.9" width="794.0" height="17.5" as="geometry"/></mxCell><mxCell id="a24" value="confirmado hasta que la obstetra agende otra cita, lo registre cumplido o lo anule." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=12.5;fontStyle=0;fontColor=#1d2733;" vertex="1" parent="1"><mxGeometry x="34.0" y="568.9" width="591.0" height="17.5" as="geometry"/></mxCell><mxCell id="a25" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4b5864;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"><mxPoint x="41.0" y="255.0" as="sourcePoint"/><mxPoint x="130.0" y="255.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a26" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4b5864;strokeWidth=1.6;endArrow=none;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="65.0" as="sourcePoint"/><mxPoint x="872.0" y="65.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a27" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4b5864;strokeWidth=1.6;endArrow=none;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"><mxPoint x="840.0" y="195.0" as="sourcePoint"/><mxPoint x="872.0" y="195.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a28" style="edgeStyle=none;html=1;rounded=0;strokeColor=#4b5